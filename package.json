{
  "name": "aroncreates.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build --local --skip-cloud-checks -c \"astro build\" && pnpm strip-admin",
    "strip-admin": "node -e \"const{rmSync}=require('node:fs');for(const d of ['dist/client/admin','dist/admin'])rmSync(d,{recursive:true,force:true})\"",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/node": "^10.1.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/astro": "^0.5.1",
    "astro": "^6.4.4",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tinacms/cli": "^2.5.3",
    "@types/node": "^25.9.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tinacms": "^3.10.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "wrangler": "^4.131.2"
  }
}