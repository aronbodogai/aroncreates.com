# Optional canonical origin override. CI builds (WORKERS_CI set) default to
# https://aroncreates.com and local builds to http://localhost:4321; set this
# only to point the sitemap, RSS feed, and OpenGraph tags somewhere else.
# SITE_URL=https://aroncreates.com

# Optional. CI is detected via WORKERS_CI; set this only to force an adapter for
# a local build or a manual `wrangler deploy`.
# DEPLOY_ADAPTER=cloudflare  # cloudflare | node
